# LangGraph checkpoint serialization must be strict before any LangGraph import.
LANGGRAPH_STRICT_MSGPACK=true

# Relative paths are resolved from the repository root.
MUSIC_AGENT_STATE_DB=data/music_agent.sqlite3

# LLM configuration (replace with local values; never commit real secrets).
MUSIC_AGENT_MODEL=glm-4.5-air
MUSIC_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MUSIC_AGENT_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=
OPENAI_API_KEY=

# QQ Music account identifier used by the existing local integration.
QQ_ID=
